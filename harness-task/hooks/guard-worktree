#!/usr/bin/env bash
set -euo pipefail

# PreToolUse hook: enforce worktree isolation
# When any active change has use_worktree: true, restrict commands that
# modify the main repo — only allow safe read-only and git meta operations.

###############################################################################
# 1. Read JSON from stdin, extract command
###############################################################################
INPUT=$(cat)
CMD=$(echo "$INPUT" | jq -r '.tool_input.command // empty')
[ -z "$CMD" ] && exit 0

###############################################################################
# 2. Check if any .dev-changes/*/status.json has use_worktree: true
###############################################################################
PROJECT_DIR="${CLAUDE_PROJECT_DIR:-}"
[ -z "$PROJECT_DIR" ] && exit 0

DEV_CHANGES_DIR="${PROJECT_DIR}/.dev-changes"
[ -d "$DEV_CHANGES_DIR" ] || exit 0

worktree_active=false
for status_file in "$DEV_CHANGES_DIR"/*/status.json; do
    [ -f "$status_file" ] || continue
    use_wt=$(jq -r '.use_worktree // false' "$status_file" 2>/dev/null || echo "false")
    stage=$(jq -r '.stage // empty' "$status_file" 2>/dev/null || true)
    # Only consider active (non-done) changes
    if [ "$use_wt" = "true" ] && [ "$stage" != "done" ]; then
        worktree_active=true
        break
    fi
done

[ "$worktree_active" = "false" ] && exit 0

###############################################################################
# 3. Get MAIN_REPO from CLAUDE_PROJECT_DIR
###############################################################################
MAIN_REPO="$PROJECT_DIR"

###############################################################################
# 4. If command targets main repo (not a worktree dir), apply restrictions
###############################################################################
# Only check commands that reference the main repo path
echo "$CMD" | grep -qF "$MAIN_REPO" || exit 0

# If command also targets a worktree directory, allow it
# Worktrees are typically siblings: {project}-worktrees/{safe-branch-dir}/
PROJECT_NAME=$(basename "$MAIN_REPO")
WORKTREE_ROOT="$(dirname "$MAIN_REPO")/${PROJECT_NAME}-worktrees"
if echo "$CMD" | grep -qF "$WORKTREE_ROOT"; then
    exit 0
fi

# Allow: git meta-ops (fetch, worktree, pull, branch, remote, log, status, diff)
if echo "$CMD" | grep -qE 'git\s+(fetch|worktree|pull|branch|remote|log|status|diff)'; then
    exit 0
fi

# Allow: read-only commands
if echo "$CMD" | grep -qE '^\s*(ls|cat|head|tail|find|grep|tree|wc|file)\s'; then
    exit 0
fi

# Allow: package manager read-only commands
if echo "$CMD" | grep -qE '^\s*(npm|pnpm|yarn)\s+(list|ls|why|outdated)'; then
    exit 0
fi

# Allow: access to .dev-changes/ and .harness-task/ directories
if echo "$CMD" | grep -qE '\.dev-changes/'; then
    exit 0
fi
if echo "$CMD" | grep -qE '\.harness-task/'; then
    exit 0
fi

# Deny everything else that targets the main repo
jq -n --arg repo "$MAIN_REPO" --arg wt "$WORKTREE_ROOT" '{
    hookSpecificOutput: {
        hookEventName: "PreToolUse",
        permissionDecision: "deny",
        permissionDecisionReason: ("Worktree isolation is active. Cannot modify main repo at " + $repo + ". Please work in the matching worktree under " + $wt + "/ instead.")
    }
}'
exit 0
